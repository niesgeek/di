{
  "name": "dino-mail",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply dino-mail --local",
    "db:migrate:remote": "wrangler d1 migrations apply dino-mail --remote",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  }
}
